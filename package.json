{
  "name": "channel3-ui",
  "version": "0.1.0",
  "description": "Open-source (MIT) React components for building shopping experiences on the Channel3 API. Distributed via the shadcn registry.",
  "homepage": "https://github.com/channel3-ai/channel3-ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/channel3-ai/channel3-ui.git"
  },
  "type": "module",
  "private": true,
  "keywords": [
    "react",
    "components",
    "shadcn",
    "ui",
    "channel3",
    "ecommerce",
    "product",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm registry:build && vite build",
    "preview": "vite preview",
    "registry:build": "shadcn build && node scripts/rewrite-registry-deps.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@channel3/sdk": "4.0.0-beta.4",
    "@tanstack/react-query": "^5.101.4",
    "embla-carousel-react": "^8.6.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.11.2",
    "lucide-react": "^1.17.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
